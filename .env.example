# Contact form email delivery (Gmail SMTP).
# Copy to .env.local for local development, and add the same three variables
# in Vercel under Project Settings -> Environment Variables.

# The Gmail account that sends the mail.
GMAIL_USER=qazicelebrant@gmail.com

# A Google App Password — NOT the account password.
# Requires 2-Step Verification on the account, then generate one at:
# https://myaccount.google.com/apppasswords
# Paste it without spaces.
GMAIL_APP_PASSWORD=

# Where enquiries are delivered.
RECIPIENT_EMAIL=qazicelebrant@gmail.com
